# ===========================================
# BACKEND API URL
# ===========================================
# Development
VITE_API_URL=http://localhost:5000

# Production - your deployed backend URL
# VITE_API_URL=https://your-backend-api.railway.app

# ===========================================
# SHOPIFY APP CONFIGURATION
# ===========================================
# Shopify API Key (Client ID) - Same as backend SHOPIFY_API_KEY
# Get this from Shopify Partner Dashboard > Apps > [Your App]
# This is PUBLIC and safe to expose in frontend
VITE_SHOPIFY_API_KEY=your_shopify_api_key_here

# ===========================================
# IMPORTANT SECURITY NOTES
# ===========================================
# ✓ VITE_SHOPIFY_API_KEY is safe to expose (public API key)
# ✗ NEVER add SHOPIFY_API_SECRET to frontend .env
# ✗ NEVER add VITE_ prefix to secrets or tokens
# ✗ NEVER add MongoDB credentials here

# ===========================================
# DEPRECATED - NO LONGER USED
# ===========================================
# The following was used for development only and is now removed:
# VITE_SHOP_DOMAIN - Shop domain now comes from URL params (?shop=...)
