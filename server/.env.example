# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# DATABASE
# ===========================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/shopify-lms

# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopify-lms?retryWrites=true&w=majority

# ===========================================
# SHOPIFY APP CONFIGURATION
# ===========================================
# Get these from your Shopify Partner Dashboard > Apps > [Your App]

# Shopify API Key (Client ID)
SHOPIFY_API_KEY=your_shopify_api_key_here

# Shopify API Secret (Client Secret) - KEEP THIS SECRET!
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Shopify API Scopes (comma-separated)
# Common scopes: read_products,write_products,read_customers,read_orders
SHOPIFY_SCOPES=read_products,write_products,read_customers

# Your app's public URL (without https://)
# Development: use ngrok or cloudflare tunnel
# Example: abc123.ngrok.io or your-app.railway.app
SHOPIFY_HOST=your-app-url.com

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Frontend URL for CORS
# Development
FRONTEND_URL=http://localhost:5173

# Production
# FRONTEND_URL=https://your-frontend-domain.com

# ===========================================
# OPTIONAL: SESSION SECRET
# ===========================================
# Generate a strong random string for production
SESSION_SECRET=your_random_session_secret_here_change_in_production
